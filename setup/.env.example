# Shared settings for the three setup scripts. Copy to .env in this folder and fill in.

# Azure AI Search
SEARCH_ENDPOINT=https://<SEARCH_SERVICE>.search.windows.net
SEARCH_API_VERSION=2026-08-01-preview

# create_knowledge_base.py - one entry per SharePoint path, kept on one line.
# Use a site or library URL (e.g. .../sites/<SITE>/ or .../sites/<SITE>/Shared Documents/),
# not a browser view URL ending in /Forms/AllItems.aspx.
KNOWLEDGE_SOURCES_JSON=[{"name":"ks-sharepoint","path":"https://<TENANT>.sharepoint.com/sites/<SITE>/"}]
KNOWLEDGE_BASE_NAME=kb-sharepoint
KNOWLEDGE_BASE_OUTPUT_MODE=extractiveData
RETRIEVAL_REASONING_EFFORT=minimal
KNOWLEDGE_BASE_DESCRIPTION=SharePoint knowledge base with extractive retrieval.

# create_connection.py / create_toolbox.py
AZURE_SUBSCRIPTION_ID=<SUBSCRIPTION_ID>
FOUNDRY_RESOURCE_GROUP=<RESOURCE_GROUP>
FOUNDRY_ACCOUNT_NAME=<FOUNDRY_ACCOUNT>
FOUNDRY_PROJECT_NAME=<PROJECT>
FOUNDRY_PROJECT_ENDPOINT=https://<FOUNDRY_ACCOUNT>.services.ai.azure.com/api/projects/<PROJECT>
KB_MCP_CONNECTION_NAME=SpKbUser
# Remote SharePoint needs the caller's own token, so use UserEntraToken.
REMOTE_TOOL_AUTH_TYPE=UserEntraToken
REMOTE_TOOL_AUDIENCE=https://search.azure.com/
TOOLBOX_NAME=sp-kb-tools
TOOLBOX_SERVER_LABEL=knowledge-base
